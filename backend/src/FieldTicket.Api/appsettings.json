{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=fieldticket;Username=app;Password=your_password_here",
    "Redis": "localhost:6379"
  },
  "WeCom": {
    "CorpId": "your_corp_id",
    "AgentId": "your_agent_id",
    "Secret": "your_secret",
    "RedirectUri": "https://your-domain.com/api/auth/wecom/callback",
    "WebBaseUrl": "http://localhost:3000",
    "RoleMappings": {
      "project_manager": {
        "WeComTags": [ "项目经理", "PM" ],
        "Departments": [ "项目管理部" ]
      },
      "sales": {
        "WeComTags": [ "销售", "Sales" ],
        "Departments": [ "销售部" ]
      },
      "engineer": {
        "WeComTags": [ "工程师", "Engineer" ],
        "Departments": [ "技术部", "工程部" ]
      },
      "management": {
        "WeComTags": [ "管理层", "Management", "总监", "VP" ],
        "Departments": [ "管理层" ]
      },
      "SeniorEngineer": {
        "WeComTags": [ "高级工程师", "SeniorEngineer", "技术专家" ],
        "Departments": [ "技术部" ]
      },
      "CS": {
        "WeComTags": [ "客服", "CS", "CustomerService" ],
        "Departments": [ "客服部" ]
      },
      "FieldEngineer": {
        "WeComTags": [ "现场工程师", "FieldEngineer", "现场" ],
        "Departments": [ "工程部", "现场服务部" ]
      }
    }
  },
  "Jwt": {
    "Secret": "your_jwt_secret_key_at_least_32_characters_long",
    "Issuer": "field-ticket-api",
    "ExpiresInHours": "168"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "attachments",
    "UseSSL": false
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o"
  }
}

