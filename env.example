# ============================================
# Field Ticket System - Environment Variables
# ============================================
# Copy this file to .env and update the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=fieldticket
POSTGRES_USER=app
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# API Configuration
# ============================================
API_PORT=5000
API_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Production

# ============================================
# Web Configuration
# ============================================
WEB_PORT=3000
WEB_URL=http://localhost:3000
WEB_DEV_URL=http://localhost:5173

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_please_change_this
JWT_ISSUER=field-ticket-api
JWT_EXPIRES_IN_HOURS=168

# ============================================
# WeCom (Enterprise WeChat) Configuration
# ============================================
WECOM_CORP_ID=your_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_secret
WECOM_REDIRECT_URI=https://your-domain.com/api/auth/wecom/callback
WECOM_WEB_BASE_URL=http://localhost:3000

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ============================================
# Zhipu AI Configuration
# ============================================
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# ============================================
# Google Gemini Configuration
# ============================================
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_GEMINI_MODEL=gemini-pro


