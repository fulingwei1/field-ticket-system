<!--index.wxml-->
<view class="container">
  <view class="header">
    <view class="user-info" wx:if="{{userInfo}}">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-role" wx:if="{{userInfo.role}}">{{userInfo.role}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="handleCreateTicket">
      <view class="menu-icon">➕</view>
      <view class="menu-text">创建工单</view>
    </view>
    
    <view class="menu-item" bindtap="handleViewTickets">
      <view class="menu-icon">📋</view>
      <view class="menu-text">我的工单</view>
    </view>
  </view>

  <view class="footer">
    <button class="btn btn-default logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>

