<!--step1.wxml-->
<view class="container">
  <view class="header">
    <text class="step-title">步骤 1/5：选择设备</text>
  </view>

  <view class="selected-device" wx:if="{{selectedDevice}}">
    <view class="card">
      <view class="device-info">
        <text class="device-name">{{selectedDevice.device_name}}</text>
        <text class="device-sn">SN: {{selectedDevice.device_sn}}</text>
        <text class="customer-name" wx:if="{{selectedDevice.customer_name}}">
          客户: {{selectedDevice.customer_name}}
        </text>
      </view>
      <button class="btn btn-default change-btn" bindtap="onChangeDevice">更换设备</button>
    </view>
  </view>

  <view class="scan-section">
    <button class="btn btn-primary scan-btn" bindtap="onScanQRCode">
      <text class="icon">📷</text>
      <text>扫描设备二维码</text>
    </button>
  </view>

  <view class="divider">
    <text>或手动选择</text>
  </view>

  <view class="search-section">
    <input
      class="search-input"
      placeholder="搜索设备SN、名称或客户"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <view class="device-list" wx:if="{{!loading}}">
    <view
      class="device-item"
      wx:for="{{deviceList}}"
      wx:key="id"
      bindtap="onSelectDevice"
      data-device-id="{{item.id}}"
    >
      <view class="device-item-content">
        <text class="device-item-name">{{item.device_name}}</text>
        <text class="device-item-sn">SN: {{item.device_sn}}</text>
        <text class="device-item-customer" wx:if="{{item.customer_name}}">
          {{item.customer_name}}
        </text>
      </view>
      <text class="device-item-arrow">›</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="footer">
    <button class="btn btn-primary next-btn" bindtap="onNext" disabled="{{!selectedDevice}}">
      下一步
    </button>
  </view>
</view>

