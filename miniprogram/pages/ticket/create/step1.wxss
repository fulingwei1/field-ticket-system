/* step1.wxss */
.header {
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.selected-device {
  padding: 30rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.device-sn {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.customer-name {
  font-size: 28rpx;
  color: #666;
}

.change-btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.scan-section {
  padding: 30rpx;
}

.scan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.scan-btn .icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background-color: #e8e8e8;
}

.divider text {
  padding: 0 20rpx;
}

.search-section {
  padding: 0 30rpx 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.device-list {
  padding: 0 30rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.device-item-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.device-item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.device-item-sn {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.device-item-customer {
  font-size: 24rpx;
  color: #999;
}

.device-item-arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 20rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.next-btn {
  width: 100%;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

