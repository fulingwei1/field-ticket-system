/* step3.wxss */
.header {
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.facts-section {
  margin-top: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.facts-list {
  display: flex;
  flex-direction: column;
}

.fact-item {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.fact-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.fact-options {
  display: flex;
  gap: 20rpx;
}

.fact-option {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #fff;
}

.fact-option.active {
  background-color: #1890ff;
  color: #fff;
  border-color: #1890ff;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 30rpx;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.prev-btn,
.next-btn {
  flex: 1;
  margin: 0 10rpx;
}

