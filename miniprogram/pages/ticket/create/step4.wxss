/* step4.wxss */
.header {
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.upload-section {
  padding: 30rpx;
}

.upload-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.upload-btn {
  height: 100rpx;
  font-size: 28rpx;
}

.upload-progress {
  text-align: center;
  padding: 20rpx;
  color: #1890ff;
  font-size: 28rpx;
}

.attachments-section {
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.attachments-list {
  display: flex;
  flex-direction: column;
}

.attachment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.attachment-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.attachment-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.attachment-size {
  font-size: 24rpx;
  color: #999;
}

.attachment-actions {
  margin-left: 20rpx;
}

.delete-btn {
  color: #ff4d4f;
  font-size: 28rpx;
}

.tips {
  padding: 30rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 30rpx;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.prev-btn,
.next-btn {
  flex: 1;
  margin: 0 10rpx;
}

