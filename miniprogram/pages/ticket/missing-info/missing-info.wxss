/* missing-info.wxss */
.header {
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #ff4d4f;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.content {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.tips {
  padding: 20rpx;
  background-color: #fff7e6;
  border-left: 4rpx solid #faad14;
  border-radius: 4rpx;
  margin-bottom: 30rpx;
}

.tips text {
  font-size: 28rpx;
  color: #faad14;
}

.questions-list {
  display: flex;
  flex-direction: column;
}

.question-item {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.required-tag {
  font-size: 24rpx;
  color: #ff4d4f;
  background-color: #fff1f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 20rpx;
}

.question-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.answer-options {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.answer-option {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #fff;
}

.answer-option.active {
  background-color: #1890ff;
  color: #fff;
  border-color: #1890ff;
}

.answer-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.answer-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  margin-top: 20rpx;
}

.file-upload {
  margin-top: 20rpx;
}

.upload-btn {
  width: 100%;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 30rpx;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.skip-btn,
.submit-btn {
  flex: 1;
  margin: 0 10rpx;
}

